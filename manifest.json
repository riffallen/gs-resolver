{
  "manifest_version": 3,
  "name": "GS URL Redirector",
  "version": "1.0",
  "description": "Redirects gs paths to GCP Storage browser",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "omnibox": {
    "keyword": "gs"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://console.cloud.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://console.cloud.google.com/storage/browser/_details/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}